{
  "name": "insightai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first business intelligence for small e-commerce teams.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:sample-data": "node --experimental-strip-types scripts/generate-sample-data.ts",
    "verify:sample-data": "node --experimental-strip-types scripts/verify-sample-data.ts",
    "reconcile:analytics": "node --experimental-strip-types scripts/reconcile-analytics.ts",
    "benchmark:analytics": "node --experimental-strip-types scripts/benchmark-analytics.ts",
    "benchmark:ingestion": "node --experimental-strip-types scripts/benchmark-ingestion.ts",
    "benchmark:findings": "node --experimental-strip-types scripts/benchmark-findings.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
